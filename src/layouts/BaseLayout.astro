---
export interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="stylesheet" href="/src/styles/global.css" />
    </head>
    <body>
        <header>
            <nav class="navbar">
                <div class="nav-container">
                    <div class="nav-brand">
                        <a href="/">Maia</a>
                    </div>
                    <div class="nav-links">
                        <a href="/">首页</a>
                        <a href="/forum">论坛</a>
                        <a href="/about">关于</a>
                    </div>
                </div>
            </nav>
        </header>

        <main>
            <slot />
        </main>

        <footer>
            <div class="footer-content">
                <p>&copy; 2025 Maia. All rights reserved.</p>
            </div>
        </footer>
    </body>
</html>
