---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ForumAPI, formatTime } from "../../utils/api.js";

// 确保页面为动态渲染模式
export const prerender = false;

// 获取分页和分类参数
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get("page") || "1");
const currentCategory = url.searchParams.get("category") || ""; // 获取分类参数
const pageSize = 10; // 每页显示的帖子数量

// 生成带分类参数的分页URL的辅助函数
function createPageUrl(page: number): string {
    const params = new URLSearchParams();
    if (page > 1) params.set("page", page.toString());
    if (currentCategory) params.set("category", currentCategory);
    return `/forum${params.toString() ? `?${params.toString()}` : ""}`;
}

// 获取帖子数据和统计信息
let posts: any[] = [];
let stats: any = {
    totalPosts: 0,
    todayPosts: 0,
    yesterdayPosts: 0,
    hotPosts: [],
};
let totalPages: number = 1;
let hasNextPage: boolean = false;
let hasPrevPage: boolean = false;
let pagination: any = {};

try {
    // 获取帖子列表
    const postsResponse = await ForumAPI.getPosts({
        page: currentPage,
        limit: pageSize,
        sort: "newest",
        category: currentCategory, // 添加分类参数
    });
    posts = postsResponse.data || [];
    pagination = postsResponse.pagination || {};

    // 获取论坛统计
    const statsResponse = await ForumAPI.getForumStats();
    stats = statsResponse.data || stats;

    // 从分页信息中获取数据
    totalPages = pagination.totalPages || 1;
    hasNextPage = pagination.hasNext || false;
    hasPrevPage = pagination.hasPrev || false;

    // 添加调试信息
    console.log("当前页:", currentPage);
    console.log("总页数:", totalPages);
    console.log("帖子数量:", posts.length);
    console.log("分页信息:", pagination);
} catch (error) {
    console.error("Failed to fetch forum data:", error);
    // 如果 API 失败，使用备用数据或显示错误信息
}
---

<BaseLayout title="讨论区 - Maia">
    <div class="forum-container">
        <!-- 论坛头部 -->
        <div class="forum-header">
            <h1 class="forum-title">讨论区</h1>
            <div class="forum-stats">
                <span>总帖数: {stats.totalPosts}</span>
                <span>今日发帖: {stats.todayPosts}</span>
                <span>在线用户: 1,234-false</span>
            </div>
            <!-- 调试信息 -->
            <div
                class="debug-info"
                style="background: #f0f0f0; padding: 10px; margin: 10px 0; border-radius: 5px; font-size: 12px;"
            >
                <strong>调试信息:</strong>
                当前页: {currentPage} | 总页数: {totalPages} | 帖子数: {
                    posts.length
                } | 有下一页: {hasNextPage ? "是" : "否"} | 有上一页: {
                    hasPrevPage ? "是" : "否"
                }
            </div>
        </div>

        <div class="forum-layout">
            <!-- 主要内容区 -->
            <div class="forum-main">
                <!-- 操作栏 -->
                <div class="forum-actions">
                    <div class="category-tabs">
                        <button
                            class={`tab ${currentCategory === "" ? "active" : ""}`}
                            onclick="filterByCategory('')"
                        >
                            全部
                        </button>
                        <button
                            class={`tab ${currentCategory === "题解" ? "active" : ""}`}
                            onclick="filterByCategory('题解')"
                        >
                            题解
                        </button>
                        <button
                            class={`tab ${currentCategory === "求助" ? "active" : ""}`}
                            onclick="filterByCategory('求助')"
                        >
                            求助
                        </button>
                        <button
                            class={`tab ${currentCategory === "讨论" ? "active" : ""}`}
                            onclick="filterByCategory('讨论')"
                        >
                            讨论
                        </button>
                        <button
                            class={`tab ${currentCategory === "灌水" ? "active" : ""}`}
                            onclick="filterByCategory('灌水')"
                        >
                            灌水
                        </button>
                    </div>
                    <button
                        class="new-post-btn"
                        onclick="location.href='/forum/post/new'"
                    >
                        发布新帖
                    </button>
                </div>
                <!-- 帖子列表 -->
                <div class="post-list">
                    {
                        posts.map((post: any) => (
                            <div class="post-item">
                                <img
                                    src={post.avatar}
                                    alt={post.author}
                                    class="post-avatar"
                                />

                                <div class="post-content">
                                    <a
                                        href={`/forum/post/${post.id}`}
                                        class="post-title"
                                    >
                                        {post.isTop && (
                                            <span class="tag top">置顶</span>
                                        )}
                                        {post.isGood && (
                                            <span class="tag good">精华</span>
                                        )}
                                        <span class="tag">{post.category}</span>
                                        {post.title}
                                    </a>

                                    <div class="post-meta">
                                        <span>作者: {post.author}</span>
                                        <span>
                                            发布时间:{" "}
                                            {formatTime(post.postTime)}
                                        </span>
                                        <span>
                                            最后回复:{" "}
                                            {formatTime(post.lastReply)}
                                        </span>
                                        <div class="post-tags">
                                            {post.tags.map((tag: any) => (
                                                <span class="tag">{tag}</span>
                                            ))}
                                        </div>
                                    </div>
                                </div>

                                <div class="post-stats">
                                    <div class="views">{post.views} 查看</div>
                                    <div class="replies">
                                        {post.replies} 回复
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
                <!-- 分页 -->
                <div class="pagination">
                    <div class="page-navigation">
                        {/* 上一页按钮 */}
                        {
                            hasPrevPage ? (
                                <a
                                    href={createPageUrl(currentPage - 1)}
                                    class="page-btn prev-btn"
                                >
                                    <span class="page-icon">‹</span>
                                    上一页
                                </a>
                            ) : (
                                <span class="page-btn prev-btn disabled">
                                    <span class="page-icon">‹</span>
                                    上一页
                                </span>
                            )
                        }

                        {/* 页码数字 */}
                        <div class="page-numbers">
                            {/* 显示第一页（如果当前页离第一页较远） */}
                            {
                                currentPage > 3 && (
                                    <a href={createPageUrl(1)} class="page-btn">
                                        1
                                    </a>
                                )
                            }
                            {
                                currentPage > 4 && (
                                    <span class="page-ellipsis">...</span>
                                )
                            }

                            {/* 显示当前页前面的页码 */}
                            {
                                currentPage > 2 && (
                                    <a
                                        href={createPageUrl(currentPage - 2)}
                                        class="page-btn"
                                    >
                                        {currentPage - 2}
                                    </a>
                                )
                            }
                            {
                                currentPage > 1 && (
                                    <a
                                        href={createPageUrl(currentPage - 1)}
                                        class="page-btn"
                                    >
                                        {currentPage - 1}
                                    </a>
                                )
                            }

                            {/* 当前页 */}
                            <a
                                href={createPageUrl(currentPage)}
                                class="page-btn active">{currentPage}</a
                            >

                            {/* 显示当前页后面的页码 */}
                            {
                                currentPage < totalPages && (
                                    <a
                                        href={createPageUrl(currentPage + 1)}
                                        class="page-btn"
                                    >
                                        {currentPage + 1}
                                    </a>
                                )
                            }
                            {
                                currentPage < totalPages - 1 && (
                                    <a
                                        href={createPageUrl(currentPage + 2)}
                                        class="page-btn"
                                    >
                                        {currentPage + 2}
                                    </a>
                                )
                            }
                            {/* 显示最后一页（如果当前页离最后一页较远） */}
                            {
                                currentPage < totalPages - 3 && (
                                    <span class="page-ellipsis">...</span>
                                )
                            }
                            {
                                currentPage < totalPages - 2 && (
                                    <a
                                        href={createPageUrl(totalPages)}
                                        class="page-btn"
                                    >
                                        {totalPages}
                                    </a>
                                )
                            }
                        </div>

                        {/* 下一页按钮 */}
                        {
                            hasNextPage ? (
                                <a
                                    href={createPageUrl(currentPage + 1)}
                                    class="page-btn next-btn"
                                >
                                    下一页
                                    <span class="page-icon">›</span>
                                </a>
                            ) : (
                                <span class="page-btn next-btn disabled">
                                    下一页
                                    <span class="page-icon">›</span>
                                </span>
                            )
                        }
                    </div>
                    <div class="page-info">
                        <span class="page-status">
                            第 {currentPage} 页，共 {totalPages} 页，共 {
                                pagination.total || stats.totalPosts
                            } 条记录
                        </span>
                        <div class="page-jump">
                            <input
                                type="number"
                                id="jumpPage"
                                min="1"
                                max={totalPages}
                                placeholder="页码"
                                class="page-input"
                            />
                            <button onclick="jumpToPage()" class="jump-btn"
                                >跳转</button
                            >
                        </div>
                    </div>
                </div>
            </div>

            <!-- 侧边栏 -->
            <div class="forum-sidebar">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">热门帖子</h3>
                    <ul class="hot-posts">
                        {
                            stats.hotPosts?.map((post: any) => (
                                <li>
                                    <a href={`/forum/post/${post.id}`}>
                                        {post.title}
                                        <span style="color: #999; font-size: 12px;">
                                            ({post.replies})
                                        </span>
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h3 class="sidebar-title">讨论区统计</h3>
                    <div class="forum-stats-detail">
                        <div class="stat-item">
                            <span class="stat-label">今日新帖</span>
                            <span class="stat-value">{stats.todayPosts}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">昨日新帖</span>
                            <span class="stat-value"
                                >{stats.yesterdayPosts || 0}</span
                            >
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">总帖数</span>
                            <span class="stat-value">{stats.totalPosts}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">总用户数</span>
                            <span class="stat-value">8,456 - false</span>
                        </div>
                    </div>
                </div>

                <div class="sidebar-section">
                    <h3 class="sidebar-title">论坛规则</h3>
                    <div class="forum-rules">
                        <ul>
                            <li>请遵守论坛规章制度</li>
                            <li>禁止发布违法违规内容</li>
                            <li>保持友善，尊重他人</li>
                            <li>禁止恶意刷屏灌水</li>
                            <li>发帖前请先搜索相关内容</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .forum-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .forum-layout {
            display: grid;
            grid-template-columns: 1fr 300px;
            gap: 20px;
            margin-top: 20px;
        }

        .forum-main {
            min-height: 600px;
        }

        .sidebar-section {
            margin-bottom: 30px;
        }

        .forum-stats-detail {
            font-size: 14px;
        }

        .stat-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #f0f0f0;
        }

        .stat-item:last-child {
            border-bottom: none;
        }

        .stat-label {
            color: #666;
        }

        .stat-value {
            color: #667eea;
            font-weight: 600;
        }

        .forum-rules ul {
            list-style: none;
            font-size: 14px;
            color: #666;
        }

        .forum-rules li {
            padding: 5px 0;
            position: relative;
            padding-left: 15px;
        }
        .forum-rules li:before {
            content: "•";
            color: #667eea;
            position: absolute;
            left: 0;
        } /* 分页样式优化 */
        .pagination {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            margin: 30px 0;
            padding: 20px;
            background: white;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .page-navigation {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .page-numbers {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .page-btn {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 8px 12px;
            border: 1px solid #e0e0e0;
            background: white;
            color: #666;
            text-decoration: none;
            border-radius: 6px;
            transition: all 0.3s ease;
            font-size: 14px;
            min-width: 40px;
            justify-content: center;
        }

        .page-btn:hover {
            background: #f5f5f5;
            border-color: #667eea;
            color: #667eea;
        }
        .page-btn.active {
            background: #667eea;
            color: white;
            border-color: #667eea;
            font-weight: 600;
        }

        .page-btn.disabled {
            background: #f5f5f5;
            color: #ccc;
            border-color: #e0e0e0;
            cursor: not-allowed;
        }

        .page-btn.disabled:hover {
            background: #f5f5f5;
            color: #ccc;
            border-color: #e0e0e0;
        }

        .prev-btn,
        .next-btn {
            padding: 8px 16px;
            font-weight: 500;
        }

        .page-icon {
            font-size: 16px;
            font-weight: bold;
        }

        .page-ellipsis {
            padding: 8px 4px;
            color: #999;
            font-size: 14px;
        }

        .page-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            font-size: 14px;
            color: #666;
            border-top: 1px solid #f0f0f0;
            padding-top: 15px;
            margin-top: 5px;
        }

        .page-jump {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .page-input {
            width: 60px;
            padding: 6px 8px;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
            text-align: center;
            font-size: 14px;
        }

        .page-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.1);
        }

        .jump-btn {
            padding: 6px 12px;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 14px;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .jump-btn:hover {
            background: #5a67d8;
        }
        @media (max-width: 768px) {
            .forum-layout {
                grid-template-columns: 1fr;
            }

            .forum-sidebar {
                order: -1;
            }

            .pagination {
                padding: 15px 10px;
            }

            .page-navigation {
                flex-direction: column;
                gap: 10px;
            }

            .page-info {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }

            .page-numbers {
                flex-wrap: wrap;
                justify-content: center;
            }

            .prev-btn,
            .next-btn {
                min-width: 80px;
            }
        }
    </style>
    <script define:vars={{ currentPage, totalPages, currentCategory }}>
        // 分类筛选功能
        function filterByCategory(category) {
            const url = new URLSearchParams(window.location.search);

            // 设置分类参数
            if (category) {
                url.set("category", category);
            } else {
                url.delete("category");
            }

            // 重置到第一页
            url.delete("page");

            // 跳转到新的URL
            window.location.href = `/forum?${url.toString()}`;
        }

        // 分页跳转功能
        function jumpToPage() {
            const pageInput = document.getElementById("jumpPage");
            if (!pageInput) return;

            const page = parseInt(pageInput.value);

            if (page && page >= 1 && page <= totalPages) {
                const url = new URLSearchParams(window.location.search);
                url.set("page", page);
                window.location.href = `/forum?${url.toString()}`;
            } else {
                alert(`请输入1到${totalPages}之间的页码`);
                pageInput.focus();
            }
        }

        // 回车键跳转
        const jumpInput = document.getElementById("jumpPage");
        if (jumpInput) {
            jumpInput.addEventListener("keypress", function (e) {
                if (e.key === "Enter") {
                    jumpToPage();
                }
            });
        }

        // 添加键盘快捷键支持
        document.addEventListener("keydown", function (e) {
            const url = new URLSearchParams(window.location.search);

            // 左箭头键：上一页
            if (e.key === "ArrowLeft" && e.ctrlKey && currentPage > 1) {
                url.set("page", currentPage - 1);
                window.location.href = `/forum?${url.toString()}`;
            }
            // 右箭头键：下一页
            else if (
                e.key === "ArrowRight" &&
                e.ctrlKey &&
                currentPage < totalPages
            ) {
                url.set("page", currentPage + 1);
                window.location.href = `/forum?${url.toString()}`;
            }
        });

        // 全局函数声明
        window.jumpToPage = jumpToPage;
        window.filterByCategory = filterByCategory;
    </script>
</BaseLayout>
