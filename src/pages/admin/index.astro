---
// 假数据
const posts = [
    { id: 1, title: "第一篇帖子", status: "待审核" },
    { id: 2, title: "第二篇帖子", status: "已发布" },
    { id: 3, title: "第三篇帖子", status: "待审核" },
];
---

<html lang="zh">
<head>
    <meta charset="UTF-8" />
    <title>后台帖子管理</title>
    <style>
        body {
            font-family: sans-serif;
            padding: 2rem;
        }
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #ccc;
            padding: 0.5rem;
            text-align: left;
        }
        .pending {
            color: orange;
        }
        .published {
            color: green;
        }
        button {
            padding: 0.3rem 0.6rem;
            background-color: red;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>

<body>
<h1>后台帖子管理</h1>
<a href="login.astro">login.astro</a>
<table>
    <thead>
    <tr>
        <th>ID</th>
        <th>标题</th>
        <th>状态</th>
        <th>操作</th>
    </tr>
    </thead>
    <tbody>
    {posts.map(post => (
            <tr id={"row-" + post.id}>
                <td>{post.id}</td>
                <td>{post.title}</td>
                <td class={post.status === "待审核" ? "pending" : "published"}>
                    {post.status}
                </td>
                <td>
                    <button onclick={`deleteRow(${post.id})`}>删除</button>
                </td>
            </tr>
    ))}
    </tbody>
</table>

<script>
    function deleteRow(id) {
        const row = document.getElementById("row-" + id);
        if (row) row.remove();
    }
</script>
</body>
</html>
